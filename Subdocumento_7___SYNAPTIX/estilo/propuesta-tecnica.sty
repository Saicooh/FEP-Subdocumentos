\NewDocumentCommand{\FuenteFigura}{m}{%
  \par\vspace{2pt}{\fontsize{9}{11}\selectfont\textcolor{SynMuted}{\textbf{Fuente:} #1}}%
}
\NewDocumentCommand{\FuenteTabla}{m}{\FuenteFigura{#1}}
\NewDocumentCommand{\FiguraTecnica}{O{width=\linewidth} m m m m}{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[#1]{#2}
    \caption{#3}
    \label{#5}
    \FuenteFigura{#4}
  \end{figure}
}
\NewDocumentCommand{\ReferenciaAnexo}{m m}{%
  \textcolor{SynNavy}{\textbf{#1}} (archivo independiente: \texttt{#2})%
}
