% Espacios de firma del representante identificado en los metadatos.
% Las líneas son campos por completar; no constituyen firmas incorporadas.
\newcommand{\MediaFirmaRepresentante}{%
  {\fontsize{8}{10}\selectfont
    \shortstack[r]{\rule{32mm}{0.3pt}\\Media firma: \RepresentanteLegal}}%
}
\newcommand{\FirmaCompletaRepresentante}{%
  \begin{minipage}{60mm}
    \raggedleft
    \setstretch{1}%
    \setlength{\parskip}{2pt}%
    \fontsize{11}{14}\selectfont
    Firma completa\par
    \vspace{10mm}%
    \rule{60mm}{0.4pt}\par
    \textbf{\RepresentanteLegal}\par
    Representante legal de \Empresa
  \end{minipage}%
}

% Encabezado y pie compartidos por páginas verticales y horizontales.
\newcommand{\MarcaEncabezadoSynaptix}{%
  \fontsize{11}{13}\selectfont\textbf{\textcolor{SynNavy}{SYNAP}\textcolor{SynBlue}{TIX}}%
}
\newcommand{\IdentificacionEncabezadoSynaptix}{%
  \fontsize{8}{10}\selectfont\textcolor{SynMuted}{\CodigoLicitacion\enspace·\enspace OFERTA TÉCNICA}%
}
\newcommand{\VersionPieSynaptix}{%
  \fontsize{8}{10}\selectfont\textcolor{SynMuted}{\ClasificacionDocumento\quad\textcolor{SynLine}{|}\quad Versión \VersionDocumento}%
}
\newcommand{\FolioPieSynaptix}{%
  \textcolor{SynMuted}{\MediaFirmaRepresentante}\hspace{5mm}%
  \fontsize{8}{10}\selectfont\textcolor{SynMuted}{Página}\enspace\textbf{\textcolor{SynBlue}{\thepage}}%
}
\newcommand{\ConfiguracionPaginaVerticalSynaptix}{%
  \fancyhf{}%
  \fancyhead[L]{\MarcaEncabezadoSynaptix}%
  \fancyhead[R]{\IdentificacionEncabezadoSynaptix}%
  \fancyfoot[L]{\VersionPieSynaptix}%
  \fancyfoot[R]{\FolioPieSynaptix}%
  \renewcommand{\headrulewidth}{0.6pt}%
  \renewcommand{\footrulewidth}{0.3pt}%
  \renewcommand{\headrule}{\hbox to\headwidth{\color{SynCyan}\leaders\hrule height 0.6pt\hfill}}%
  \renewcommand{\footrule}{\hbox to\headwidth{\color{SynLine}\leaders\hrule height 0.3pt\hfill}}%
}
\fancypagestyle{synaptixvertical}{\ConfiguracionPaginaVerticalSynaptix}
\fancypagestyle{plain}{\ConfiguracionPaginaVerticalSynaptix}
\pagestyle{synaptixvertical}
\setlength{\footskip}{30pt}

% pdflscape gira el cuerpo, pero no el encabezado y el pie de fancyhdr.
% Estos elementos se sitúan y giran sobre la hoja para conservar su posición
% al leer el PDF horizontal: marca arriba y media firma/folio abajo a la derecha.
\fancypagestyle{synaptixhorizontal}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \renewcommand{\headrule}{}%
  \renewcommand{\footrule}{}%
  \fancyfoot[C]{%
    \begin{tikzpicture}[remember picture,overlay]
      \node[rotate=90,anchor=west] at ($(current page.south west)+(15mm,27mm)$)
        {\MarcaEncabezadoSynaptix};
      \node[rotate=90,anchor=east] at ($(current page.north west)+(15mm,-24mm)$)
        {\IdentificacionEncabezadoSynaptix};
      \draw[SynCyan,line width=.6pt]
        ($(current page.south west)+(20mm,27mm)$) --
        ($(current page.north west)+(20mm,-24mm)$);
      \node[rotate=90,anchor=west] at ($(current page.south east)+(-13mm,27mm)$)
        {\VersionPieSynaptix};
      \node[rotate=90,anchor=east] at ($(current page.north east)+(-13mm,-24mm)$)
        {\FolioPieSynaptix};
      \draw[SynLine,line width=.3pt]
        ($(current page.south east)+(-19mm,27mm)$) --
        ($(current page.north east)+(-19mm,-24mm)$);
    \end{tikzpicture}%
  }%
}
\newenvironment{paginaHorizontalSynaptix}{%
  \clearpage
  % Márgenes transpuestos para conservar 27/24 mm a izquierda/derecha
  % y 26/24 mm arriba/abajo después del giro de la página.
  \newgeometry{top=24mm,bottom=27mm,left=26mm,right=24mm,headheight=24pt,footskip=30pt}%
  \begin{landscape}%
  \pagestyle{synaptixhorizontal}%
  \setlength{\LTcapwidth}{\linewidth}%
}{%
  \end{landscape}%
  \restoregeometry
  \pagestyle{synaptixvertical}%
}

